# Optional: Search the public web via Tavily (never paste into source code)
TAVILY_API_KEY=
# Keyless calls are rate limited; set to 1 to try without a key.
TAVILY_KEYLESS=0
# Optional: 1 to enable model download when semantic analysis is selected.
# The first run downloads the pretrained Sentence Transformer (~90 MB).
TRACELENS_ALLOW_MODEL_DOWNLOAD=1

# Wikipedia is free for public reading: NO API key needed.
# Required to identify requests under Wikimedia User-Agent policy.
# Enter your own email or HTTPS project URL, or enter it in the Analyze screen.
WIKIMEDIA_CONTACT=
